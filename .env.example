# Team Work AI — chaves de API (NUNCA faça commit do .env real)
# As chaves são lidas apenas pelo daemon, via variáveis de ambiente.
# Copie para .env e preencha, ou exporte na sessão / no systemd --user.

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Anthropic (Claude) não tem tier gratuito — exige TEAMWORK_AI_ALLOW_PAID_MODELS=true
# abaixo pra ser usado de verdade (Jorginho, o agente Tech Lead, usa este provedor).
ANTHROPIC_API_KEY=

# Opcionais
# TEAMWORK_AI_SOCKET=/caminho/customizado.sock
# TEAMWORK_AI_DB=/caminho/customizado.db
# TEAMWORK_AI_ALLOW_PAID_MODELS=false
# RUST_LOG=info
