# Unidade systemd --user do daemon Team Work AI.
# Instalar em: ~/.config/systemd/user/teamwork-ai-daemon.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now teamwork-ai-daemon
#
# Chaves de API: crie ~/.config/teamwork-ai/env (chmod 600) no formato
#   GEMINI_API_KEY=...
# Nunca faça commit desse arquivo.

[Unit]
Description=Team Work AI daemon (orquestrador local de agentes)
Documentation=file:///usr/share/doc/teamwork-ai/README.md
After=default.target

[Service]
Type=simple
# Instalação de usuário (~/.local/bin) ou pacote (/usr/bin)
ExecStart=%h/.local/bin/teamwork-ai-daemon
Restart=on-failure
RestartSec=3
# Variáveis opcionais (arquivo pode não existir)
EnvironmentFile=-%h/.config/teamwork-ai/env
Environment=RUST_LOG=info
# Endurecimento básico (processo do usuário, sem root)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome fica DESLIGADO de propósito: o provedor claude-code (agência
# "sem shell") edita arquivos do usuário — projetos, vault — e o CLI precisa
# gravar o próprio estado em ~/.claude. O shell continua bloqueado pelo gate
# de ferramentas do CLI, não pelo sandbox do systemd.
# StateDirectory/CacheDirectory/RuntimeDirectory: o systemd CRIA essas pastas
# (sob %S, %C, %t) antes de montar o sandbox.
StateDirectory=teamwork-ai
CacheDirectory=teamwork-ai
RuntimeDirectory=teamwork-ai

[Install]
WantedBy=default.target
